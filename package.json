{
  "name": "@video-vault/video-vault-common-types",
  "version": "0.0.1",
  "description": "Common library for types for backend and frontends of VideoVault.",
  "private": false,
  "type": "module",
  "main": "built/index.js",
  "types": "built/index.d.ts",
  "files": [
    "built"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "better-npm-audit audit",
    "qa": "npm run lint && npm run audit",
    "build": "tsc --project tsconfig.json && tsc-alias -f -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.26.0",
    "@typescript-eslint/eslint-plugin": "8.10.0",
    "better-npm-audit": "^3.11.0",
    "eslint": "9.26.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "prettier": "3.3.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.54.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/video-vault-org/video-vault-common-types.git"
  },
  "author": "Johanna Herrmann",
  "license": "MIT"
}
